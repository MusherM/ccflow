{
  "name": "ccflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "start": "bun run src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "proto:ink": "tsx --tsconfig prototypes/ink-node-view/tsconfig.json prototypes/ink-node-view/src/main.tsx",
    "proto:opentui": "bun run prototypes/opentui-node-view/src/main.ts",
    "proto:typecheck": "tsc -p prototypes/ink-node-view/tsconfig.json --noEmit && tsc -p prototypes/opentui-node-view/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.2.14",
    "@types/react": "^19.2.14",
    "ink": "^7.0.3",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
